MYSQL_DATABASE=autopackline
MYSQL_USER=autopackline
MYSQL_PASSWORD=autopackline
MYSQL_ROOT_PASSWORD=root_autopackline
MYSQL_HOST_PORT=3307
JWT_SECRET=change-me-development-only
JWT_EXP_MINUTES=480
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrador AUTOPACKLINE
INITIAL_ADMIN_PASSWORD=Autopack@2026
VITE_TIME_ZONE=America/Manaus

# ETAPA 6.4 - Rede local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.90.100.162:5173,https://localhost:5173,https://127.0.0.1:5173,https://10.90.100.162:5173
# Deixe vazio para o frontend usar automaticamente o mesmo IP/hostname do navegador.
VITE_API_URL=

# ETAPA 6.5 - câmera móvel
# false = mantém HTTP atual; Foto / câmera funciona no celular.
# true = Vite usa HTTPS autoassinado e habilita tentativa do scanner ao vivo.
AUTOPACKLINE_HTTPS=false

# ETAPA 7.9 - comunicação CLP simulada
PLC_SIMULATOR_TIMEOUT_SECONDS=5
PLC_RETRY_MAX_ATTEMPTS=3
PLC_RETRY_INTERVAL_SECONDS=1

# ETAPA 7.31 - reteste controlado
# O fluxo real permanece bloqueado ate a aprovacao das regras de processo.
RETEST_ENABLED=false
RETEST_SIMULATOR_ENABLED=true
RETEST_MAX_ATTEMPTS=2
MES_QUALITY_ENABLED=false
MES_QUALITY_SIMULATOR_ENABLED=true
MES_QUALITY_MODE=PENDING_CONTRACT
MES_QUALITY_BASE_URL=
MES_QUALITY_TIMEOUT_MS=3000

# ETAPA 7.33 - contrato Rev.02 e transporte físico protegido
PLC_PHYSICAL_ENABLED=false
PLC_READ_ONLY_ENABLED=false
PLC_WRITE_ENABLED=false
PLC_ISPSOFT_COMPILED=false
PLC_REGISTER_OFFSET_VALIDATED=false
PLC_ASCII_BYTE_ORDER_VALIDATED=false
PLC_NETWORK_VALIDATED=false
PLC_READER_ETHERNETIP_VALIDATED=false
PLC_PHYSICAL_E2E_AUTHORIZED=false
PLC_MODBUS_HOST=192.168.29.5
PLC_MODBUS_PORT=502
PLC_MODBUS_UNIT_ID=1
PLC_PC_IP=192.168.29.10
PLC_NETMASK=255.255.255.0
# 0 ou 1; confirmar no primeiro teste com a biblioteca Modbus utilizada.
PLC_MODBUS_ADDRESS_BASE=0
# HIGH_LOW confirmado no contrato; validar fisicamente com AB12.
PLC_ASCII_BYTE_ORDER=HIGH_LOW

# ETAPA 7.34 - CLP-Simulator externo (independente do CLP físico)
PLC_EXTERNAL_SIMULATOR_ENABLED=false
PLC_EXTERNAL_SIMULATOR_WRITE_ENABLED=false
PLC_EXTERNAL_SIMULATOR_HOST=host.docker.internal
PLC_EXTERNAL_SIMULATOR_PORT=1502
PLC_EXTERNAL_SIMULATOR_UNIT_ID=1
PLC_EXTERNAL_SIMULATOR_LOGICAL_ORIGIN=700
PLC_EXTERNAL_SIMULATOR_REGISTER_BASE=0
PLC_EXTERNAL_SIMULATOR_TIMEOUT_MS=1000

# Formato do QR publicado pelo leitor/CLP. Remova ",url" e use false caso a
# Automação opte pelo payload curto compatível com D847-D878 (64 bytes).
BARCODE_DELIMITER=;
BARCODE_FIELD_ORDER=model,ean,serial,production_order,url
BARCODE_URL_REQUIRED=true
