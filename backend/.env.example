APP_NAME=AUTOPACKLINE API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://autopackline:autopackline@mysql:3306/autopackline
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me

PLC_SIMULATOR_TIMEOUT_SECONDS=5
PLC_RETRY_MAX_ATTEMPTS=3
PLC_RETRY_INTERVAL_SECONDS=1

# ETAPA 7.20 - transporte Modbus TCP real (SAFE DEFAULT: desabilitado)
PLC_PHYSICAL_ENABLED=false
PLC_MODBUS_HOST=192.168.0.2
PLC_MODBUS_PORT=502
PLC_MODBUS_UNIT_ID=1

# ETAPA 7.31 - reteste real bloqueado ate definicao do processo
RETEST_ENABLED=false
RETEST_SIMULATOR_ENABLED=true
